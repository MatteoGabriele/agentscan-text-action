{
	"name": "agentscan-text-action",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"description": "GitHub Action that flags agent-written PR descriptions",
	"author": "Matteo Gabriele <m.gabriele.dev@gmail.com>",
	"license": "MIT",
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"check": "biome check --write",
		"release": "bumpp",
		"test": "vitest",
		"collect:adopters": "node --env-file-if-exists=.env scripts/collect-adopters.ts",
		"collect:adopters:dry-run": "node --env-file-if-exists=.env scripts/collect-adopters.ts --dry-run"
	},
	"dependencies": {
		"@unveil/interlinked": "^0.0.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.1.1",
		"bumpp": "^11.1.0",
		"tsdown": "^0.22.5",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
